# Mobile — seules les clés publiques Supabase vont dans l'application Expo.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
EXPO_PUBLIC_APP_MODE=demo
EXPO_PUBLIC_ENABLE_PUBLIC_GEOCODING=false

# Admin
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_APP_MODE=demo

# Edge Functions — à définir avec `supabase secrets set`, jamais dans le mobile.
OPEN_FOOD_FACTS_USER_AGENT=PrixPei/0.1 (contact@example.com)
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
